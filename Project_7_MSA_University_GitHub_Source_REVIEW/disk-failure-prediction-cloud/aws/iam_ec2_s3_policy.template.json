{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteOnlyThisProjectBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::REPLACE_WITH_BUCKET_NAME"]
    },
    {
      "Sid": "ReadWriteOnlyProjectPrefix",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": ["arn:aws:s3:::REPLACE_WITH_BUCKET_NAME/disk-failure/*"]
    }
  ]
}
